{
  "name": "plexer-reborn-v2",
  "version": "2.0.0",
  "description": "Plexer-Reborn V2 - Modern Vue 3 Plex Client",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
