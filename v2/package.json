    "@ffmpeg/util": "^0.12.2",
    "@tailwindcss/postcss": "^4.1.17",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "fast-xml-parser": "^5.3.2",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.6.15",
    "mitt": "^3.0.1",
    "pinia": "^3.0.4",
    "plyr": "^3.8.3",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
